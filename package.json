{
  "name": "hibi",
  "desktopName": "com.ryanaque.hibi.desktop",
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "description": "hibi desktop",
  "homepage": "https://github.com/schmayterling/hibi",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vim.mjs && node scripts/patch-electron-vite.mjs && node scripts/patch-electron-notarize.mjs && install-electron --no",
    "dev": "npm run docs && node scripts/dev.mjs",
    "start": "npm run dev",
    "preview": "node scripts/preview.mjs",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:site": "node scripts/build-site.mjs",
    "build:app": "npm run docs && electron-vite build && npm run build:site",
    "build": "npm run typecheck && npm run build:app",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "bench": "vitest bench --run bench/core",
    "bench:build": "npm run typecheck && npm run docs && node scripts/build-provenance.mjs",
    "bench:desktop": "node bench/desktop/startup.bench.mjs",
    "bench:startup": "node scripts/benchmark-startup.mjs",
    "bench:input": "node scripts/benchmark-input.mjs",
    "docs": "node scripts/docs.mjs",
    "docs:check": "npm run docs && node scripts/docs-links.mjs",
    "copy:catalog": "node scripts/ui-copy.mjs",
    "copy:check": "node scripts/ui-copy.mjs --check",
    "sdk:pack": "npm pack ./packages/addon-sdk",
    "create:addon": "node packages/create-hibi-addon/index.mjs",
    "export:docs": "npm run docs && npm run build:site && node scripts/export-docs.mjs",
    "check": "npm run lint && npm run docs:check && npm run copy:check && npm test",
    "check:ci": "node scripts/ci.mjs",
    "package": "npm run build && electron-builder --dir -c.mac.identity=-",
    "dist": "npm run check && electron-builder --publish never"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@bbob/html": "4.4.1",
    "@bbob/preset-html5": "4.4.1",
    "@biomejs/biome": "2.5.15",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codspeed/tinybench-plugin": "6.1.0",
    "@codspeed/vitest-plugin": "6.1.0",
    "@lezer/highlight": "1.2.5",
    "@markdoc/markdoc": "0.5.10",
    "@mdx-js/mdx": "3.1.1",
    "@replit/codemirror-vim": "6.4.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-drag-handle": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/d3-force": "3.0.10",
    "@types/katex": "0.16.8",
    "@types/luaparse": "0.2.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "5.2.0",
    "d3-force": "3.0.0",
    "dompurify": "3.4.17",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "geist": "1.8.1",
    "hast-util-to-html": "9.0.5",
    "ignore": "7.0.13",
    "katex": "0.18.10",
    "lucide-react": "1.59.0",
    "marked": "18.1.1",
    "mdast-util-to-hast": "13.2.1",
    "mdsvex": "0.12.8",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "pele": "1.10.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.35.0",
    "svelte": "5.57.2",
    "tinybench": "6.2.2",
    "typescript": "7.0.2",
    "unzipper": "0.12.5",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "electron-updater": "6.8.9",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "luaparse": "0.3.1",
    "marked-github-footnote": "1.0.0",
    "sanitize-html": "2.18.1"
  }
}
