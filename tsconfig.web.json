{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/site/**/*.ts",
    "src/site/**/*.tsx",
    "src/addons/*/index.ts",
    "src/addons/*/index.tsx",
    "src/addons/*/*.worker.ts",
    "src/useraddons/*/index.ts",
    "src/useraddons/*/index.tsx",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/fixtures/local-diagnostics-off/renderer.ts"
  ]
}
