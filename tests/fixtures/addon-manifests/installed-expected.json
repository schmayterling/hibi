{
  "manifest": {
    "id": "foundation-proof",
    "name": "Foundation proof",
    "description": "A small consumer of Hibi's public foundation APIs.",
    "apiVersion": 3,
    "kind": "extension",
    "version": "1.0.0",
    "authors": [
      {
        "displayName": "Hibi contributors"
      }
    ],
    "defaultEnabled": false,
    "capabilities": ["ui"],
    "commands": [
      {
        "id": "capture",
        "label": "Capture foundation proof",
        "defaultShortcut": "mod+alt+shift+f11",
        "menu": {
          "location": "app",
          "group": "foundation-proof"
        }
      }
    ],
    "startup": "background"
  },
  "entry": "index.js",
  "themes": []
}
