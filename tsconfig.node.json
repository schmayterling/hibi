{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2023"]
  },
  "include": [
    "src/addons/*/native.ts",
    "src/addons/*/compiler-worker.ts",
    "src/addons/dictionary/custom-words-worker.ts",
    "src/addons/*/manifest.ts",
    "src/useraddons/*/native.ts",
    "src/useraddons/*/manifest.ts",
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
