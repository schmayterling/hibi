{
  "id": "org",
  "name": "Org mode",
  "description": "Edit, preview, and export Org mode documents.",
  "apiVersion": 2,
  "kind": "extension",
  "version": "1.0.2",
  "authors": [
    {
      "discordId": "1262793452236570667",
      "displayName": "may"
    }
  ],
  "defaultEnabled": false,
  "dependencies": [
    {
      "id": "pandoc",
      "name": "Pandoc",
      "command": "pandoc",
      "homepage": "https://pandoc.org/installing.html",
      "reason": "Convert document source for previews and HTML exports. Requires Pandoc 3.11 or newer.",
      "install": {
        "brew": {
          "package": "pandoc"
        },
        "winget": "JohnMacFarlane.Pandoc"
      }
    }
  ],
  "fileExtensions": ["org"],
  "entry": "index.ts",
  "native": {
    "entry": "native.ts"
  }
}
